<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="using:ElectricityTracker.Models"
        mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="560"
        x:Class="ElectricityTracker.MainWindow"
        Width="960" Height="560" MinWidth="560" MinHeight="400"
        Title="Electricity Tracker">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="PeriodStartBrush" Color="#E6E6E6" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="PeriodStartBrush" Color="#3A3A3A" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Window.Styles>
        <!-- Rows where the period total resets; selection and hover keep their usual highlight. -->
        <Style Selector="ListBoxItem.periodStart:not(:selected):not(:pointerover) /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PeriodStartBrush}" />
        </Style>
    </Window.Styles>

    <Grid Margin="16" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" ColumnDefinitions="*">
        <TextBlock Grid.Row="0" Text="Capture reading" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />

        <WrapPanel Grid.Row="1" Orientation="Horizontal">
            <StackPanel Margin="0,0,16,8" Spacing="4">
                <TextBlock Text="Date" />
                <CalendarDatePicker x:Name="DateInput" Width="160" SelectedDateFormat="Custom" CustomDateFormatString="yyyy-MM-dd" />
            </StackPanel>
            <StackPanel Margin="0,0,16,8" Spacing="4">
                <TextBlock Text="Time" />
                <TimePicker x:Name="TimeInput" ClockIdentifier="24HourClock" />
            </StackPanel>
            <StackPanel Margin="0,0,16,8" Spacing="4">
                <TextBlock Text="Reading" />
                <NumericUpDown x:Name="ReadingInput" Width="180" Minimum="0" Increment="1"
                               ShowButtonSpinner="False" PlaceholderText="e.g. 12345" />
            </StackPanel>
            <StackPanel Margin="0,0,16,8" Spacing="4">
                <TextBlock Text="Notes (optional)" />
                <TextBox x:Name="NotesInput" Width="240" AcceptsReturn="False"
                         PlaceholderText="e.g. used tumble dryer" />
            </StackPanel>
            <StackPanel Margin="0,0,0,8" Spacing="4" VerticalAlignment="Bottom" Orientation="Horizontal">
                <Button x:Name="AddButton" Content="Add" IsDefault="True" Click="OnAddClick" />
                <Button x:Name="ReplaceButton" Content="Replace existing" IsVisible="False" Click="OnReplaceClick" />
            </StackPanel>
        </WrapPanel>

        <TextBlock Grid.Row="2" x:Name="StatusText" TextWrapping="Wrap" Margin="0,4,0,8" />

        <TextBlock Grid.Row="3" x:Name="PeriodSummaryText" FontWeight="SemiBold" TextWrapping="Wrap" />

        <Grid Grid.Row="4" ColumnDefinitions="110,70,150,110,90,110,*" Margin="12,8,12,4">
            <Button Grid.Column="0" Click="OnDateHeaderClick" ToolTip.Tip="Reverse the order"
                    Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                <TextBlock x:Name="DateHeader" Text="Date ▼" FontWeight="SemiBold" />
            </Button>
            <TextBlock Grid.Column="1" Text="Time" FontWeight="SemiBold" />
            <TextBlock Grid.Column="2" x:Name="ReadingHeader" Text="Reading" FontWeight="SemiBold" />
            <TextBlock Grid.Column="3" Text="Usage" FontWeight="SemiBold" />
            <TextBlock Grid.Column="4" Text="Cost" FontWeight="SemiBold" />
            <TextBlock Grid.Column="5" Text="Period total" FontWeight="SemiBold" />
            <TextBlock Grid.Column="6" Text="Notes" FontWeight="SemiBold" />
        </Grid>

        <ListBox Grid.Row="5" x:Name="ReadingsList">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="models:ReadingRow">
                    <Grid ColumnDefinitions="110,70,150,110,90,110,*">
                        <Button Grid.Column="0" Click="OnDateClick" ToolTip.Tip="Edit notes"
                                Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                            <TextBlock Text="{Binding Reading.Date, StringFormat='{}{0:yyyy-MM-dd}'}"
                                       TextDecorations="Underline" />
                        </Button>
                        <TextBlock Grid.Column="1" Text="{Binding Reading.Time, StringFormat='{}{0:HH:mm}'}" />
                        <TextBlock Grid.Column="2" Text="{Binding Reading.Reading}" />
                        <TextBlock Grid.Column="3" Text="{Binding UsageText}" />
                        <TextBlock Grid.Column="4" Text="{Binding CostText}" />
                        <TextBlock Grid.Column="5" Text="{Binding PeriodTotalText}" />
                        <TextBlock Grid.Column="6" Text="{Binding Reading.Notes}" TextTrimming="CharacterEllipsis" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>
