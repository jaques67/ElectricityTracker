<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="using:ElectricityTracker.Models"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="500"
        x:Class="ElectricityTracker.MainWindow"
        Width="800" Height="500" MinWidth="560" MinHeight="400"
        Title="Electricity Tracker">
    <Grid Margin="16" RowDefinitions="Auto,Auto,Auto,Auto,*" ColumnDefinitions="*">
        <TextBlock Grid.Row="0" Text="Capture reading" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />

        <WrapPanel Grid.Row="1" Orientation="Horizontal">
            <StackPanel Margin="0,0,16,8" Spacing="4">
                <TextBlock Text="Date" />
                <CalendarDatePicker x:Name="DateInput" Width="160" SelectedDateFormat="Custom" CustomDateFormatString="yyyy-MM-dd" />
            </StackPanel>
            <StackPanel Margin="0,0,16,8" Spacing="4">
                <TextBlock Text="Time" />
                <TimePicker x:Name="TimeInput" ClockIdentifier="24HourClock" />
            </StackPanel>
            <StackPanel Margin="0,0,16,8" Spacing="4">
                <TextBlock Text="Reading" />
                <NumericUpDown x:Name="ReadingInput" Width="180" Minimum="0" Increment="1"
                               ShowButtonSpinner="False" PlaceholderText="e.g. 12345" />
            </StackPanel>
            <StackPanel Margin="0,0,0,8" Spacing="4" VerticalAlignment="Bottom" Orientation="Horizontal">
                <Button x:Name="AddButton" Content="Add" IsDefault="True" Click="OnAddClick" />
                <Button x:Name="ReplaceButton" Content="Replace existing" IsVisible="False" Click="OnReplaceClick" />
            </StackPanel>
        </WrapPanel>

        <TextBlock Grid.Row="2" x:Name="StatusText" TextWrapping="Wrap" Margin="0,4,0,8" />

        <Grid Grid.Row="3" ColumnDefinitions="120,100,*" Margin="12,8,12,4">
            <TextBlock Grid.Column="0" Text="Date" FontWeight="SemiBold" />
            <TextBlock Grid.Column="1" Text="Time" FontWeight="SemiBold" />
            <TextBlock Grid.Column="2" x:Name="ReadingHeader" Text="Reading" FontWeight="SemiBold" />
        </Grid>

        <ListBox Grid.Row="4" x:Name="ReadingsList">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="models:ElectricityReading">
                    <Grid ColumnDefinitions="120,100,*">
                        <TextBlock Grid.Column="0" Text="{Binding Date, StringFormat='{}{0:yyyy-MM-dd}'}" />
                        <TextBlock Grid.Column="1" Text="{Binding Time, StringFormat='{}{0:HH:mm}'}" />
                        <TextBlock Grid.Column="2" Text="{Binding Reading}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>
